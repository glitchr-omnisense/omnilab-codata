parameters:
	ignoreErrors:
		-
			message: '#^Cannot cast mixed to float\.$#'
			identifier: cast.double
			count: 1
			path: CodataSourceFactory.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: CodataSourceFactory.php

		-
			message: '#^Argument of an invalid type list\<string\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$domain on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$id on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 4
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$kind on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$label on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 5
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$synonyms on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot access property \$url on Omnilab\\Model\\Entity\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot call method number\(\) on Omnilab\\Model\\Property\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot call method property\(\) on Omnilab\\Model\\Entity\|null\.$#'
			identifier: method.nonObject
			count: 4
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot call method unit\(\) on Omnilab\\Model\\Property\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CodataSourceTest.php

		-
			message: '#^Cannot call method value\(\) on Omnilab\\Model\\Entity\|null\.$#'
			identifier: method.nonObject
			count: 12
			path: Tests/CodataSourceTest.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: Tests/CodataSourceTest.php
